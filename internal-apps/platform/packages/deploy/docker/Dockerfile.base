# @company/deploy base image — multi-stage, non-root, healthcheck.
# Apps: FROM this file's stages via `docker build -f node_modules/@company/deploy/docker/Dockerfile.base`
# or copy into apps/<app>/Dockerfile when they outgrow it.

# ---- build ----
FROM node:22-slim AS build
WORKDIR /app
ENV NODE_ENV=production
ARG APP_NAME
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile --prod=false \
 && pnpm --filter "${APP_NAME}" build

# ---- runtime ----
FROM node:22-slim AS runtime
ARG APP_NAME
ENV NODE_ENV=production \
    APP_NAME=${APP_NAME} \
    PORT=8080
WORKDIR /app
RUN groupadd -r app && useradd -r -g app app
COPY --from=build --chown=app:app /app /app
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# shell form so ${APP_NAME} expands at container start
CMD node apps/${APP_NAME}/dist/server.js
